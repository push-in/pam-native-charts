{
    "name": "pushinbr/pam-native-charts",
    "description": "Native charts for PAM Native: line, area, bar, donut, sparkline and progress ring drawn on pam-native-canvas.",
    "type": "pam-native-plugin",
    "license": "Apache-2.0",
    "keywords": [
        "pam",
        "native",
        "charts",
        "canvas",
        "android",
        "ios",
        "php"
    ],
    "homepage": "https://github.com/push-in/pam-native-charts",
    "support": {
        "issues": "https://github.com/push-in/pam-native-charts/issues",
        "source": "https://github.com/push-in/pam-native-charts"
    },
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.13",
        "pushinbr/pam-native-canvas": "^0.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "pushinbr/pam-native-plugin-kit": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Charts\\": "src/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
